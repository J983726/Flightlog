<%- include('partials/head', { title: 'Flights' }) %>
<section class="totals">
  <div class="stat"><span class="num"><%= hmm(totals.minutes) %></span><span class="lbl">Total time</span></div>
  <div class="stat"><span class="num"><%= totals.flights %></span><span class="lbl">Flights</span></div>
  <div class="stat"><span class="num"><%= hmm(totals.month) %></span><span class="lbl">This month</span></div>
  <div class="stat"><span class="num"><%= totals.last || '—' %></span><span class="lbl">Last flight</span></div>
</section>

<% if (!flights.length) { %>
  <section class="card empty">
    <p>No flights yet.</p>
    <a class="btn btn-primary" href="/flights/new">Log your first flight</a>
  </section>
<% } else { %>
  <div class="table-wrap">
    <table class="flights">
      <thead>
        <tr>
          <th>Date</th><th>Time</th><th class="r">Min</th><th>Battery</th><th>Location</th>
          <th>Class</th><th class="r">Alt</th><th>Practice / notes</th><th></th>
        </tr>
      </thead>
      <tbody>
      <% flights.forEach(function (f) { %>
        <tr>
          <td class="nowrap"><%= f.flight_date %></td>
          <td class="nowrap"><%= f.start_time %>–<%= f.end_time %><% if (f.end_date !== f.flight_date) { %> <span class="tag">+1</span><% } %></td>
          <td class="r"><%= f.minutes %></td>
          <td><%= f.battery_label || '' %></td>
          <td><%= f.location_name || f.location_text || '' %></td>
          <td><%= f.airspace %><% if (f.auth) { %> <span class="tag" title="<%= f.auth %>">auth</span><% } %></td>
          <td class="r"><%= f.max_alt_ft ?? '' %></td>
          <td class="clip"><%= [f.practice, f.notes].filter(Boolean).join(' · ') %></td>
          <td class="nowrap actions">
            <a href="/flights/<%= f.id %>/edit">Edit</a>
            <a class="danger" href="/flights/<%= f.id %>/delete">Delete</a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/foot') %>
